# --- Personal repo overrides (career-ops-personal) ---
# This branch/repo tracks personal data intentionally. Upstream template
# excluded data/, reports/, output/ — we keep them so work syncs across
# machines. Build artifacts and OS junk stay ignored below.

# Latex build artifacts (build-resume.sh cleans these, but be defensive)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
texput.log

# User-private config the upstream still doesn't want committed
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Generated junk
.resolved-prompt-*
node_modules/

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local settings (memory itself is synced via claude-memory/)
.claude/settings.local.json
career-dashboard
